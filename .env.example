# Server-only secrets. Never expose these to the browser.
MIDTRANS_SERVER_KEY=YOUR_SERVER_KEY_HERE
# Client Key may be exposed only if the selected Midtrans client flow requires it.
MIDTRANS_CLIENT_KEY=YOUR_CLIENT_KEY_HERE
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_API_BASE_URL=https://app.sandbox.midtrans.com
DATABASE_URL=not_used_with_d1
PROVIDER_API_KEY=YOUR_PROVIDER_API_KEY_HERE
PROVIDER_API_SECRET=YOUR_PROVIDER_API_SECRET_HERE
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_HERE

# Checkout pricing: customer pays a fixed Application/Service Fee plus applicable PPN.
SERVICE_FEE_AMOUNT=2000
SERVICE_FEE_VAT_RATE=0.11
# PPN charged on Midtrans transaction fees. Keep aligned with the merchant tax treatment shown by Midtrans.
MIDTRANS_FEE_VAT_RATE=0.11
# Optional per-channel override. Example: {"qris":{"percent":0.007,"fixed":0}}
MIDTRANS_FEE_CONFIG_JSON=
# Payment method selected at checkout when no method is supplied.
DEFAULT_PAYMENT_METHOD=bank_transfer

# Only for local/mock testing. Never enable for production checkout.
ALLOW_DEMO_PRICING=false

# Admin authentication now uses the D1 admins table (multi-user). Seed the first owner with scripts/seed-admin.mjs.
# No admin password is stored in environment variables in production.
# Used to sign the HttpOnly admin session cookie.
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# OTP ownership verification
RESEND_API_KEY=YOUR_RESEND_API_KEY
OTP_FROM_EMAIL="Aji Wira <noreply@example.com>"

# Turnstile anti-spam. If configured, public write endpoints require a valid token.
TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY_HERE

# Real PPOB/biller adapter. Leave unset until a real provider contract is available.
DIGITAL_PROVIDER_API_URL=
DIGITAL_PROVIDER_API_KEY=

# E-wallet: 10% all-in deduction (includes applicable tax/charges)
EWALLET_DEDUCTION_RATE=0.10
